# Append ".NS" to tickers for Yahoo Finance format (NS = National Stock Exchange)
tickers <- paste0(ticker_list$Symbol, ".NS")
tickers <- tickers[!tickers %in% c("ETERNAL.NS", "JIOFIN.NS", "TMPV.NS")]
# Initialize empty dataframe to store all ticker data
ticker_df <- data.frame()
# Loop through each ticker and download its historical data
for(nms in tickers){
# Download data from Yahoo Finance
df <- getSymbols(Symbols = nms, verbose = FALSE, auto.assign = FALSE)
# Convert to dataframe and add ticker and date information
df <- fortify(df)
colnames(df) <- c("date", "open", "high", "low", "close", "volume", "adjusted")
df$ticker <- nms
# Append to the main dataframe
ticker_df <- rbind(ticker_df, df)
Sys.sleep(0.1)
}
# Reshape data to wide format with dates as rows and tickers as columns
# Remove any duplicate entries for the same date and ticker (if any)
ticker_df <- ticker_df %>%
group_by(date, ticker) %>%
slice(1) %>%
ungroup()
prices_df <- pivot_wider(ticker_df, id_cols = "date", names_from = "ticker", values_from = "close")
# Remove rows with missing values to ensure complete data
prices_df <- na.omit(prices_df)
# Check the date range of our data
range(prices_df$date)
# Check dimensions (number of trading days × number of stocks + date column)
dim(prices_df)
library(slider)  # For rolling window calculations
# Extract metal stock tickers
metal_tickers <- ticker_list |>
dplyr::filter(stringr::str_detect(tolower(Industry), "metal")) |>
dplyr::mutate(ticker = paste0(Symbol, ".NS")) |>
dplyr::pull(ticker)
# Compute daily returns for metal stocks
metal_returns <- prices_df |>
dplyr::select(date, dplyr::any_of(metal_tickers)) |>
dplyr::mutate(date = as.Date(date)) |>
dplyr::arrange(date) |>
dplyr::mutate(dplyr::across(-date, \(x) x / dplyr::lag(x) - 1)) |>
tidyr::drop_na()
dates   <- metal_returns$date
ret_mat <- as.matrix(metal_returns[, -1])
# Get all unique pairs
pairs <- combn(colnames(ret_mat), 2, simplify = FALSE)
# Rolling 60-day correlation for each pair
roll_corr <- purrr::map(pairs, \(pair) {
slider::slide_dbl(
seq_len(nrow(ret_mat)),
\(idx) cor(ret_mat[idx, pair[1]], ret_mat[idx, pair[2]]), .before = 90, .complete = TRUE
)
})
# Average correlation across all pairs at each date
avg_corr <- purrr::reduce(roll_corr, `+`) / length(roll_corr)
avg_corr_df <- tibble::tibble(
date     = dates,
avg_corr = avg_corr
) |>
tidyr::drop_na()
# Area chart with regime shading
ggplot(avg_corr_df, aes(x = date, y = avg_corr)) +
geom_ribbon(aes(ymin = 0, ymax = avg_corr, fill = avg_corr > 0.6),
alpha = 0.35, show.legend = FALSE) +
geom_line(linewidth = 0.7, colour = "grey30") +
geom_hline(yintercept = 0.6, linetype = "dashed",
colour = "firebrick", linewidth = 0.5) +
annotate("text", x = min(avg_corr_df$date), y = 0.63,
label = "High correlation threshold (0.6)",
hjust = 0, size = 3, colour = "firebrick") +
scale_fill_manual(values = c("FALSE" = "steelblue", "TRUE" = "firebrick")) +
scale_y_continuous(limits = c(0, 1),
labels = scales::label_number(accuracy = 0.1)) +
theme_minimal() +
labs(
title    = "Rolling 60-Day Average Pairwise Correlation",
subtitle = "Nifty 50 metal stocks — red shading = high-correlation regime",
x        = "Date",
y        = "Average Pairwise Correlation"
) +
theme(
axis.title.x = element_text(face = "bold"),
axis.title.y = element_text(face = "bold")
)
