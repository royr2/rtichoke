# Create a code scnippet to genrate a set of random numbers
# that are right skewed and are centered around 150 in R
set.seed(123)  # For reproducibility
n <- 1000  # Number of random numbers
right_skewed_data <- rlnorm(n, meanlog = log(150), sdlog = 0.5)
# Plot the distribution to visualize the right skewness
hist(right_skewed_data, breaks = 30, main = "Right Skewed Distribution",
xlab = "Value", ylab = "Frequency", col = "lightblue", border = "black")
