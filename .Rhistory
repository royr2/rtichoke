pacman::p_load(DoubleML, mlr3, mlr3learners)
# 1. Load the Bonus dataset
df_bonus = fetch_bonus(return_type = "data.table")
# 2. Define the data structure
# Outcome: inuidur1 (log duration of unemployment)
# Treatment: tg (offered cash bonus)
# Confounders: female, black, age, industry, etc.
dml_data_bonus = DoubleMLData$new(df_bonus,
y_col = "inuidur1",
d_cols = "tg",
x_cols = c("female", "black", "othrace", "dep1", "dep2",
"q2", "q3", "q4", "q5", "q6", "agelt35",
"agegt54", "durable", "lusd", "husd"))
# 3. Specify ML learners (Random Forest)
learner = lrn("regr.ranger", num.trees = 500, max.depth = 5, min.node.size = 2)
ml_l = learner$clone() # For E[Y|X]
ml_m = learner$clone() # For E[D|X]
# 4. Initialize and fit the DML model
obj_dml_plr_bonus = DoubleMLPLR$new(dml_data_bonus, ml_l = ml_l, ml_m = ml_m)
obj_dml_plr_bonus$fit()
# 5. View results
print(obj_dml_plr_bonus)
