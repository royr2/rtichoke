# install.packages("torch")
library(torch)
torch::install_torch()
install.packages("ggplot2")
.libaths()
.libPaths()
# Simple Gamification System in R
# Tracks user activities and awards points, levels, and badges
# Define the User class using R6
library(R6)
# User class with gamification features
User <- R6Class("User",
public = list(
name = NULL,
points = 0,
level = 1,
badges = character(0),
activities = list(),
# Initialize user
initialize = function(name) {
self$name <- name
cat(sprintf("Welcome, %s! Start your journey.\n", name))
},
# Perform an activity and earn points
complete_activity = function(activity_name, points_earned) {
self$points <- self$points + points_earned
self$activities <- append(self$activities, activity_name)
cat(sprintf("✓ %s completed! +%d points\n", activity_name, points_earned))
# Check for level up
self$check_level_up()
# Check for badges
self$check_badges()
# Show status
self$show_status()
},
# Check if user leveled up
check_level_up = function() {
new_level <- floor(self$points / 100) + 1
if (new_level > self$level) {
self$level <- new_level
cat(sprintf("\n🎉 LEVEL UP! You are now Level %d!\n\n", self$level))
}
},
# Check for badge achievements
check_badges = function() {
# Beginner badge
if (self$points >= 50 && !("Beginner" %in% self$badges)) {
self$badges <- c(self$badges, "Beginner")
cat("\n🏅 Badge Unlocked: Beginner (50 points)\n\n")
}
# Enthusiast badge
if (self$points >= 200 && !("Enthusiast" %in% self$badges)) {
self$badges <- c(self$badges, "Enthusiast")
cat("\n🏅 Badge Unlocked: Enthusiast (200 points)\n\n")
}
# Consistent Learner badge
if (length(self$activities) >= 5 && !("Consistent Learner" %in% self$badges)) {
self$badges <- c(self$badges, "Consistent Learner")
cat("\n🏅 Badge Unlocked: Consistent Learner (5 activities)\n\n")
}
# Master badge
if (self$points >= 500 && !("Master" %in% self$badges)) {
self$badges <- c(self$badges, "Master")
cat("\n🏅 Badge Unlocked: Master (500 points)\n\n")
}
},
# Display current status
show_status = function() {
cat(sprintf("\n--- %s's Profile ---\n", self$name))
cat(sprintf("Level: %d\n", self$level))
cat(sprintf("Points: %d\n", self$points))
cat(sprintf("Activities Completed: %d\n", length(self$activities)))
if (length(self$badges) > 0) {
cat(sprintf("Badges: %s\n", paste(self$badges, collapse = ", ")))
} else {
cat("Badges: None yet\n")
}
cat("-------------------\n\n")
},
# Show leaderboard comparison
compare_with = function(other_user) {
cat("\n=== LEADERBOARD ===\n")
users <- list(
list(name = self$name, points = self$points, level = self$level),
list(name = other_user$name, points = other_user$points, level = other_user$level)
)
# Sort by points
users <- users[order(sapply(users, function(u) u$points), decreasing = TRUE)]
for (i in seq_along(users)) {
cat(sprintf("%d. %s - Level %d (%d points)\n",
i, users[[i]]$name, users[[i]]$level, users[[i]]$points))
}
cat("===================\n\n")
}
)
)
# ============================================
# DEMO: Simulating a learning journey
# ============================================
cat("\n========== GAMIFICATION DEMO ==========\n\n")
# Create two users
alice <- User$new("Alice")
bob <- User$new("Bob")
cat("\n--- Alice's Learning Journey ---\n\n")
# Alice completes various learning activities
alice$complete_activity("Read Introduction to R", 20)
Sys.sleep(0.5)
alice$complete_activity("Complete Data Types Tutorial", 30)
Sys.sleep(0.5)
alice$complete_activity("Practice Vector Operations", 25)
Sys.sleep(0.5)
alice$complete_activity("Build First Plot with ggplot2", 40)
Sys.sleep(0.5)
alice$complete_activity("Complete dplyr Exercise", 35)
Sys.sleep(0.5)
alice$complete_activity("Advanced Data Wrangling", 50)
Sys.sleep(0.5)
alice$complete_activity("Build Shiny Dashboard", 100)
cat("\n--- Bob's Learning Journey ---\n\n")
# Bob completes some activities
bob$complete_activity("Read Introduction to R", 20)
Sys.sleep(0.5)
bob$complete_activity("Complete Data Types Tutorial", 30)
Sys.sleep(0.5)
bob$complete_activity("Practice Vector Operations", 25)
# Compare the two users
alice$compare_with(bob)
cat("\n========== DEMO COMPLETE ==========\n")
