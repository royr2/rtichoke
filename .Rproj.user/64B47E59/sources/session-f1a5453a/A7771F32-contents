# Create initial combined matrix (simple average)
M_combined <- (M1 + M2 + M3 + M4 + M5) / 5

# Function to find optimal weight for approximating a target matrix
find_optimal_weight <- function(M_target, M_combined) {
  objective <- function(w) {
    return(sum((M_target - w * M_combined)^2))
  }
  
  result <- optimize(f = objective, interval = c(0, 10))
  return(result$minimum)
}

# Find optimal weights for each matrix
weights <- c(
  find_optimal_weight(M1, M_combined),
  find_optimal_weight(M2, M_combined),
  find_optimal_weight(M3, M_combined),
  find_optimal_weight(M4, M_combined),
  find_optimal_weight(M5, M_combined)
)

# Normalize weights to sum to 1
weights <- weights / sum(weights)

weights
