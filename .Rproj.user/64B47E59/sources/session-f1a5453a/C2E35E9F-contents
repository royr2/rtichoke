# Matrix decomposition approach for portfolio evolution
# Think of this like breaking down a complex recipe into simpler ingredients


k <- 4

# 1. Decompose large transition matrix (like separating cake into flour, eggs, sugar)
large_transition_matrix <- stacked_data  # Your input matrix
decomposed <- svd(large_transition_matrix)    # Singular Value Decomposition
small_matrix <- decomposed$u[, 1:k] %*% diag(decomposed$d[1:k]) %*% t(decomposed$v[, 1:k])

# 2. Weight by portfolio composition (like adjusting recipe portions)
weights_matrix <- your_weights  # Portfolio segment weights
weighted_transition <- weights_matrix %*% small_matrix

# 3. Evolve portfolio over time (like baking - each step builds on the last)
current_portfolio <- your_initial_state
n_periods <- 10

for(t in 1:n_periods) {
  current_portfolio <- current_portfolio %*% weighted_transition
}

# Alternative: Direct evolution without loop
final_portfolio <- your_initial_state %*% (weighted_transition %^% n_periods)